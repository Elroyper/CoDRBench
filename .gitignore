/private/
/staging/
/audit_outputs/
/review_outputs/
/outputs/
/artifacts/

# Paper drafts and local source material
/*.pdf
/*.docx
/*.tex

# Publication guard: data files require an explicit .gitignore change
/data/*
!/data/README.md
