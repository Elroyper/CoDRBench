# Operating-system and editor files
.DS_Store
.idea/
.vscode/
*~

# Python and notebooks
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Environments and credentials
.env
.env.*
!.env.example
*.key
*.pem
credentials*
secrets*

